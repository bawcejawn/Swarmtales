# SwarmTales testnet settings. Public addresses only.
# Copy this file to deploy/testnet.env and edit that copy.
# deploy/testnet.env is gitignored.
#
# Never put a private key, seed phrase, or WIF in this file.
# The prepare script stops if it sees one.

# Koinos Foundation testnet. This is not Harbinger and not mainnet.
# Chain id was read from this node on 19 October 2026.
# Read it again before you upload: chain.get_chain_id
TESTNET_RPC=https://testnet.koinosfoundation.org
TESTNET_CHAIN_ID=EiAIKVvm6-V2qmsmUvPJy09vCCLbtn9lHFpwrJbcTIEWRQ==

# Carl's testnet wallet. This is the admin after set_admin.
# It is not a contract address. Do not upload Ink or Shop to this address.
ADMIN_ADDRESS=18MhKFHohFqVNpy7m7XvDRqZgLgVspyRF6

# Create a new wallet for each contract. Paste only the public address here,
# after you have written the seed down somewhere that is not this repo.
INK_CONTRACT_ADDRESS=
SHOP_CONTRACT_ADDRESS=

# Where test payments go. For a first test these can be the admin wallet.
# They must not be the Shop contract address.
TREASURY_ADDRESS=18MhKFHohFqVNpy7m7XvDRqZgLgVspyRF6
FOUNDER_ADDRESS=18MhKFHohFqVNpy7m7XvDRqZgLgVspyRF6
