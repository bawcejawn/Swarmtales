# Dependencies and build output. Recreated by yarn install / yarn build:debug.
node_modules/
build/
coverage/

# Secrets. Public address examples are committed. Real env files are not.
.env
.env.*
*.pem
*.key
*.wallet
id_rsa
id_rsa.*

# Generated by koinos-sdk-as-cli. Rebuild them; do not edit them.
# The **/ form covers both the Ink folder and shop/.
**/assembly/index.ts
**/assembly/*.boilerplate.ts
**/assembly/proto/*.ts
**/abi/*.abi
**/abi/*-abi.json

# Protoc descriptor left next to the project by the ABI generator.
*.pb

# Local junk
.DS_Store
*.log

# Your copy of the testnet addresses. The example file is committed.
deploy/testnet.env
uploads/
agent-tools/

# as-pect compiler leftovers
**/assembly/__tests__/*.map
**/assembly/__tests__/*.wat
**/assembly/__tests__/*.wasm
